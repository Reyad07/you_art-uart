<?xml version="1.0" encoding="UTF-8"?>
<wave_config>
   <wave_state>
   </wave_state>
   <db_ref_list>
      <db_ref path="top.wdb" id="1">
         <top_modules>
            <top_module name="fifo_tb" />
         </top_modules>
      </db_ref>
   </db_ref_list>
   <zoom_setting>
      <ZoomStartTime time="0.000 ns"></ZoomStartTime>
      <ZoomEndTime time="62.701 ns"></ZoomEndTime>
      <Cursor1Time time="0.000 ns"></Cursor1Time>
   </zoom_setting>
   <column_width_setting>
      <NameColumnWidth column_width="340"></NameColumnWidth>
      <ValueColumnWidth column_width="155"></ValueColumnWidth>
   </column_width_setting>
   <WVObjectSize size="5" />
   <wvobject fp_name="/fifo_tb/clk" type="logic">
      <obj_property name="ElementShortName">clk</obj_property>
      <obj_property name="ObjectShortName">clk</obj_property>
   </wvobject>
   <wvobject fp_name="/fifo_tb/arst_n" type="logic">
      <obj_property name="ElementShortName">arst_n</obj_property>
      <obj_property name="ObjectShortName">arst_n</obj_property>
   </wvobject>
   <wvobject fp_name="group8" type="group">
      <obj_property name="label">Inputs</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="group16" type="group">
         <obj_property name="label">Config</obj_property>
         <obj_property name="DisplayName">label</obj_property>
         <wvobject fp_name="/fifo_tb/en" type="logic">
            <obj_property name="ElementShortName">en</obj_property>
            <obj_property name="ObjectShortName">en</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/push_in" type="logic">
            <obj_property name="ElementShortName">push_in</obj_property>
            <obj_property name="ObjectShortName">push_in</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/pop_in" type="logic">
            <obj_property name="ElementShortName">pop_in</obj_property>
            <obj_property name="ObjectShortName">pop_in</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/threshold" type="array">
            <obj_property name="ElementShortName">threshold[3:0]</obj_property>
            <obj_property name="ObjectShortName">threshold[3:0]</obj_property>
            <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
         </wvobject>
      </wvobject>
      <wvobject fp_name="/fifo_tb/data_in" type="array">
         <obj_property name="ElementShortName">data_in[7:0]</obj_property>
         <obj_property name="ObjectShortName">data_in[7:0]</obj_property>
      </wvobject>
   </wvobject>
   <wvobject fp_name="group15" type="group">
      <obj_property name="label">Output</obj_property>
      <obj_property name="DisplayName">label</obj_property>
      <obj_property name="isExpanded"></obj_property>
      <wvobject fp_name="/fifo_tb/data_out" type="array">
         <obj_property name="ElementShortName">data_out[7:0]</obj_property>
         <obj_property name="ObjectShortName">data_out[7:0]</obj_property>
      </wvobject>
      <wvobject fp_name="group17" type="group">
         <obj_property name="label">Status</obj_property>
         <obj_property name="DisplayName">label</obj_property>
         <obj_property name="isExpanded"></obj_property>
         <wvobject fp_name="/fifo_tb/empty" type="logic">
            <obj_property name="ElementShortName">empty</obj_property>
            <obj_property name="ObjectShortName">empty</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/full" type="logic">
            <obj_property name="ElementShortName">full</obj_property>
            <obj_property name="ObjectShortName">full</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/underrun" type="logic">
