         <wvobject fp_name="/fifo_tb/overrun" type="logic">
            <obj_property name="ElementShortName">overrun</obj_property>
            <obj_property name="ObjectShortName">overrun</obj_property>
         </wvobject>
         <wvobject fp_name="/fifo_tb/thrs_trig" type="logic">
            <obj_property name="ElementShortName">thrs_trig</obj_property>
            <obj_property name="ObjectShortName">thrs_trig</obj_property>
         </wvobject>
      </wvobject>
